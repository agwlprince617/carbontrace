{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CarbonTrace: start local app",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/uvicorn",
      "args": ["carbontrace.app:create_app", "--factory", "--host", "127.0.0.1", "--port", "8765"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "CarbonTrace: tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/pytest",
      "args": ["--cov=carbontrace", "--basetemp=.tmp/pytest"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
